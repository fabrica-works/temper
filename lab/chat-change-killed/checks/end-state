#!/usr/bin/env -S python3 -I -B
"""Collect live forge evidence, or judge retained files without network or clock."""

import argparse
import http.client
import json
from pathlib import Path
import re
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _end_state import _Status, _Verdict, _decode_objects, _judge, _project_observations


def _read_objects(port, commits, evidence, number):
    request = json.dumps({"commits": commits}, separators=(",", ":")).encode("ascii")
    stem = evidence / f"objects-{number}"
    stem.with_suffix(".request.json").write_bytes(request)
    connection = http.client.HTTPConnection("127.0.0.1", port)
    # Direct numeric listener: no proxy, redirects, credentials or retries.
    # The runner's command_seconds bounds the entire collection.
    try:
        with stem.with_suffix(".response.body").open("wb") as saved:
            try:
                connection.request("POST", "/.fake/git/objects", body=request,
                                   headers={"Content-Type": "application/json"})
                response = connection.getresponse()
            except (OSError, http.client.HTTPException) as error:
                print(f"objects-{number} unavailable ({type(error).__name__})", file=sys.stderr)
                return None
            print(f"objects-{number} HTTP {response.status}; commits={commits}", file=sys.stderr)
            chunks = []
            while not response.isclosed():
                try:
                    chunk = response.read1(65536)
                except (OSError, http.client.HTTPException) as error:
                    if isinstance(error, http.client.IncompleteRead):
                        saved.write(error.partial)
                    print(f"objects-{number} unavailable ({type(error).__name__})", file=sys.stderr)
                    return None
                if not chunk:
                    break
                saved.write(chunk)
                saved.flush()
                chunks.append(chunk)
            if response.status != 200 or response.length not in (None, 0):
                return None
            return _decode_objects(b"".join(chunks), commits)
    finally:
        connection.close()


def _collect(observations, address, out):
    data = observations.read_bytes()
    out.mkdir(parents=True, exist_ok=True)
    (out / "observations.jsonl").write_bytes(data)
    facts = _project_observations(data)
    if _judge(**facts, objects=None, notice=b"Maintained by temper.\n").reason != "store unreadable":
        return
    listener = re.fullmatch(r"127\.0\.0\.1:([0-9]{1,5})", address)
    if listener is None or not 1 <= int(listener[1]) <= 65535:
        print("end-state: forge address unavailable", file=sys.stderr)
        return
    commit = facts["last_merged"]
    first = _read_objects(int(listener[1]), [commit], out, 1)
    if first is not None and first[commit].parent is not None:
        _read_objects(int(listener[1]), [commit, first[commit].parent], out, 2)


def _judge_directory(directory):
    facts = _project_observations((directory / "observations.jsonl").read_bytes())
    notice = (Path(__file__).resolve().parent.parent / "NOTICE").read_bytes()
    inputs = dict(**facts, notice=notice)
    verdict = _judge(**inputs, objects=None)
    if verdict.reason != "store unreadable":
        return verdict
    commit = facts["last_merged"]
    first = _decode_objects((directory / "objects-1.response.body").read_bytes(), [commit])
    if first is None or first[commit].parent is None:
        return _judge(**inputs, objects=first)
    parent = first[commit].parent
    objects = _decode_objects((directory / "objects-2.response.body").read_bytes(), [commit, parent])
    # Never fill a partial second response from the first one.
    return _judge(**inputs, objects=objects)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    collect = commands.add_parser("collect")
    collect.add_argument("observations", type=Path)
    collect.add_argument("forge_address", help="127.0.0.1:PORT from the forge ready line")
    collect.add_argument("out", type=Path)
    judge = commands.add_parser("judge")
    judge.add_argument("directory", type=Path)
    args = parser.parse_args()
    if args.command == "collect":
        try:
            _collect(args.observations, args.forge_address, args.out)
        except OSError as error:
            print(f"end-state: collection files unavailable ({type(error).__name__})", file=sys.stderr)
            return 1
        return 0
    try:
        verdict = _judge_directory(args.directory)
    except (OSError, ValueError) as error:
        print(f"end-state: inputs/read unavailable ({type(error).__name__})", file=sys.stderr)
        verdict = _Verdict(_Status.UNDECIDED, reason="end-state inputs/read unavailable")
    for line in verdict.evidence:
        print(line, file=sys.stderr)
    for signature in verdict.signatures:
        print(json.dumps(dict(fail=signature, summary="end-state: " + signature)))
    if verdict.status == _Status.UNDECIDED:
        print(json.dumps(dict(undecided=verdict.reason)))
    return int(verdict.status)


if __name__ == "__main__":
    sys.exit(main())
