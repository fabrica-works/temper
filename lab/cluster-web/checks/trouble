#!/usr/bin/python3
"""Judge the hand's redacted trouble without depending on a running browser."""
import json
import re
import sys
from urllib.parse import urlsplit


def page(address):
    # docs/design/client/browser.md 2.3 and
    # crates/temper-client-domain/src/address.rs (Address).
    try:
        url = urlsplit(address)
        if url.scheme == 'about' and url.path == 'blank':
            return 'blank'
        if url.scheme != 'http' or url.hostname not in {'127.0.0.1', '::1', 'localhost'}:
            return 'off-origin'
    except ValueError:
        return 'off-origin'
    paths = {'/': 'inbox', '/chats': 'chats', '/accounts': 'accounts',
             '/jig/v1/sign-in/link': 'sign-in'}
    if url.path in paths:
        return paths[url.path]
    for pattern, name in ((r'/chats/[0-9]+', 'chat'), (r'/tasks/[0-9]+', 'task'),
                          (r'/projects/[0-9]+/adopt', 'adopt')):
        if re.fullmatch(pattern, url.path):
            return name
    return 'other'


def judge(lines):
    groups = {}
    records = []
    for number, line in enumerate(lines, 1):
        try:
            entry = json.loads(line)
            if (type(entry) is not dict
                    or set(entry) != {'n', 'kind', 'text', 'address', 'call', 'during'}
                    or type(entry['n']) is not int or entry['n'] < 1
                    or type(entry['call']) is not int or entry['call'] < 0
                    or any(type(entry[k]) is not str for k in ('kind', 'text', 'address'))
                    or not re.fullmatch(r'[a-z][a-z0-9-]*', entry['kind'])
                    or (entry['during'] is not None and type(entry['during']) is not str)):
                raise ValueError('entry shape')
        except (ValueError, TypeError):
            records.append({'undecided': f'trouble.jsonl line {number} unreadable'})
            continue
        if entry['during'] == 'sign-in':
            continue
        signature = 'browser/' + entry['kind'] + '/' + page(entry['address'])
        if signature not in groups:
            record = {'fail': signature, 'summary': ''}
            groups[signature] = [0, entry['text'], record]
            records.append(record)
        groups[signature][0] += 1
    for count, text, record in groups.values():
        record['summary'] = f'{count} {"entry" if count == 1 else "entries"}; first: {text}'[:200]
    return (1 if groups else 2 if records else 0), records


def main():
    if len(sys.argv) != 2:
        print('usage: trouble LOG', file=sys.stderr)
        return 2
    try:
        with open(sys.argv[1], encoding='utf-8') as log:
            status, records = judge(log.readlines())
    except (OSError, UnicodeError):
        status, records = 2, [{'undecided': 'trouble.jsonl missing'}]
    for record in records:
        print(json.dumps(record, sort_keys=True, separators=(',', ':')))
    return status


if __name__ == '__main__':
    sys.exit(main())
