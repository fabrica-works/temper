#!/bin/sh
set -eu
if [ "$#" -ne 2 ]; then
    echo 'usage: smoke BROWSE ADDRESS' >&2
    exit 2
fi
browse=$1
address=$2
call() {
    printf '+ browse'
    printf ' %s' "$@"
    printf '\n'
    "$browse" "$address" "$@"
}
# For address reads keep the output while still printing the call and answer.
read_address() {
    printf '+ browse address\n'
    address_status=0
    current=$("$browse" "$address" address) || address_status=$?
    printf '%s\n' "$current"
    return "$address_status"
}
printf 'cluster-first-chat\n' | call type 'text area' 'Start a chat'
call press button Start --exact
call wait log Conversation --timeout 60
# The reply shows as its turn commits, which the cue's wait ends at the
# charter's waiting_ms, 60 s (lab/README.md): 90 s leaves a margin.
call wait text 'First worker replied.' --in log Conversation --timeout 90
read_address
case "$current" in
    http://*/chats/*) ;;
    *) echo 'smoke: expected an http chat address' >&2; exit 1 ;;
esac
origin=${current%%/chats/*}
chat=${current#"$origin"}
hostport=${origin#http://}
case "$hostport" in
    \[*\]:*) host=${hostport%:*}; port=${hostport##*:}; case "$host" in *']') ;; *) exit 1 ;; esac ;;
    *:*) host=${hostport%:*}; port=${hostport##*:} ;;
    *) echo 'smoke: expected host and port in chat address' >&2; exit 1 ;;
esac
case "$host" in
    \[*\])
        literal=${host#\[}
        literal=${literal%\]}
        case "$literal" in ''|*[!0-9a-fA-F:.]*) echo 'smoke: invalid chat host' >&2; exit 1 ;; esac
        ;;
    ''|*[!a-zA-Z0-9.-]*) echo 'smoke: invalid chat host' >&2; exit 1 ;;
esac
case "$port" in ''|*[!0-9]*) echo 'smoke: invalid chat port' >&2; exit 1 ;; esac
task=${chat#/chats/}
case "$task" in ''|*[!0-9]*) echo 'smoke: expected /chats/<digits>' >&2; exit 1 ;; esac
call go /chats
call wait heading Chats --exact --timeout 60
call go "$chat"
call wait text 'First worker replied.' --in log Conversation --timeout 60
call reload
call wait text 'First worker replied.' --in log Conversation --timeout 60
call shot
call back
call wait heading Chats --exact --timeout 60
read_address
if [ "$current" != "$origin/chats" ]; then
    printf 'smoke: expected %s/chats after back; got %s\n' "$origin" "$current" >&2
    exit 1
fi
