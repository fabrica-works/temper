#!/bin/sh
# Keep Python isolated, as skein's look/capture launcher does.
umask 077
exec python3 -I -B -S - "$0" "$@" <<'PYTHON'
"""Build one committed gallery subject and judge each requested experiment."""
import os
from pathlib import Path
import shlex
import subprocess
import sys


def run(argv, repository, *, capture=True):
    print('+ ' + shlex.join(map(str, argv)), file=sys.stderr, flush=True)
    result = subprocess.run(argv, cwd=repository, text=True,
                            stdout=subprocess.PIPE if capture else sys.stderr)
    if capture and result.stdout:
        print(result.stdout, file=sys.stderr, end='', flush=True)
    return result


def main():
    if len(sys.argv) < 4:
        print('usage: lab/look-judge SKEIN EXPERIMENT...', file=sys.stderr)
        return 2
    repository = Path(sys.argv[1]).resolve().parent.parent
    skein = Path(sys.argv[2]).resolve()
    experiments = sys.argv[3:]
    lab = skein / 'scripts' / 'lab' / 'lab'
    if not lab.is_file() or not os.access(lab, os.X_OK):
        print(f'look-judge: expected an executable at {lab}', file=sys.stderr)
        return 2
    for experiment in experiments:
        if not (repository / experiment).is_dir():
            print(f'look-judge: expected an experiment directory: {experiment}',
                  file=sys.stderr)
            return 2
    status = run(['git', 'status', '--porcelain'], repository)
    if status.returncode:
        return 4
    if status.stdout:
        print('look-judge: repository must be clean', file=sys.stderr)
        return 2
    commit = run(['git', 'rev-parse', 'HEAD'], repository)
    if commit.returncode:
        return 4
    build = run(['heavy', 'cargo', 'build', '--release', '-p', 'temper-gallery'],
                repository, capture=False)
    if build.returncode:
        return 4
    target = Path(os.environ.get('CARGO_TARGET_DIR', 'target'))
    artifact = (repository / target / 'release' / 'temper-gallery').resolve()
    subject = run([lab, 'subject', '--repository', repository,
                   '--commit', commit.stdout.strip(), '--exclude', 'lab',
                   '--artifact', 'gallery=' + str(artifact)], repository)
    if subject.returncode:
        return subject.returncode
    digest = subject.stdout.strip()
    first_error = 0
    failures = {2: 'refused', 3: 'not enough evidence', 4: 'error'}
    for experiment in experiments:
        key = run([lab, 'validate', experiment, '--subject', digest], repository)
        if key.returncode:
            code = key.returncode
            print(f'{experiment} - {failures.get(code, "error")}', flush=True)
        else:
            judged = run([lab, 'judge', experiment, '--subject', digest], repository)
            code = judged.returncode
            lines = judged.stdout.splitlines()
            verdict = lines[-1] if lines else failures.get(code, 'error')
            print(f'{experiment} {key.stdout.strip()} {verdict}', flush=True)
        if code not in (0, 1) and not first_error:
            first_error = code
    return first_error


try:
    sys.exit(main())
except (OSError, ValueError) as error:
    print(f'look-judge: {error}', file=sys.stderr)
    sys.exit(4)
PYTHON
