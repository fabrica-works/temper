#!/bin/sh
# The live scene states (lab/README.md, The live scenes, The seed).
set -eu
if [ "$#" -ne 3 ]; then
    echo 'usage: steps PHASE BROWSE ADDRESS' >&2
    exit 2
fi
phase=$1
browse=$2
address=$3
call() {
    printf '+ browse'
    printf ' %s' "$@"
    printf '\n'
    "$browse" "$address" "$@"
}
case "$phase" in
send)
    printf 'look-live-chat\n' | call type 'text area' 'Start a chat'
    call press button Start --exact
    call wait log Conversation --timeout 120
    printf 'look-live-sent\n' | call type 'text area' Message
    call key Enter
    call wait text 'First reply.' --in log Conversation --timeout 180
    ;;
reload)
    call reload
    call wait text 'First reply.' --in log Conversation --timeout 120
    ;;
close)
    call press button Close --exact
    call wait dialog Close --exact --timeout 120
    ;;
*) echo 'steps: expected send, reload or close' >&2; exit 2 ;;
esac
