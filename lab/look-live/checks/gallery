#!/usr/bin/python3
"""Compare gallery and live frames (qa-web.md, 8.2; lab/README.md)."""
import argparse
from collections import Counter
import hashlib
import json
from pathlib import Path
import re
import sys

# skein scripts/lab/look/outline.py, plus the live dialog's landmark.
LANDMARKS = {'banner', 'navigation', 'main', 'complementary', 'contentinfo',
             'region', 'form', 'search', 'dialog'}
NAME = re.compile(r'[a-z][a-z0-9-]*\Z')
LABEL = re.compile(r'([a-z][a-z0-9-]*(?: [1-6]| \([0-9]+\))?)(?: (".*"))?\Z')


def label(text):
    match = LABEL.fullmatch(text)
    if not match:
        raise ValueError('unreadable outline label')
    role, name = match.groups()
    return role, json.loads(name) if name else None


def frame(text):
    """Count frame entries with their enclosing landmarks, ignoring content."""
    counts, landmarks = Counter(), []
    # Each stack member is (label, selected subtree, saw first region).
    for line in text.splitlines():
        if not line:
            continue
        own = line.lstrip(' ')
        spaces = len(line) - len(own)
        depth = spaces // 2
        if spaces % 2 or depth > len(landmarks):
            raise ValueError('unreadable outline indentation')
        landmarks = landmarks[:depth]
        role, name = label(own)
        main = next((part for part in reversed(landmarks) if part[3] == 'main'), None)
        selected = role in ('banner', 'dialog') or any(part[1] for part in landmarks)
        if role == 'region' and main is not None and not main[2]:
            main[2] = True
            selected = True
        if main is not None and (role, name) in (('textbox', 'Message'), ('button', 'Send')):
            selected = True
        if selected:
            counts[' > '.join([part[0] for part in landmarks] + [own])] += 1
        if role in LANDMARKS:
            landmarks.append([own, selected, False, role])
    return counts


def _encoded(text):
    # Copied from skein scripts/lab/look/checks.py (_encoded).
    return ''.join(chr(byte) if (ord('a') <= byte <= ord('z') or ord('A') <= byte <= ord('Z')
                                or ord('0') <= byte <= ord('9') or byte in b'._~-')
                   else f'%{byte:02X}' for byte in text.encode('utf-8'))


def entry_signature(kind, entry):
    # skein scripts/lab/look/checks.py (_own, entry_signature): split only
    # outside JSON names, whose words may themselves contain " > ".
    start, quoted, escaped = 0, False, False
    for index, char in enumerate(entry):
        if escaped:
            escaped = False
        elif char == '\\' and quoted:
            escaped = True
        elif char == '"':
            quoted = not quoted
        elif not quoted and entry.startswith(' > ', index):
            start = index + 3
    role, name = label(entry[start:])
    tail = kind + '/' + role.replace('(', '').replace(')', '').replace(' ', '-')
    return tail + '/' + _encoded(name) if name else tail


def compare(live, gallery, scene, width):
    """Pure comparison; group identical signatures, retaining landmark evidence."""
    left, right = frame(live), frame(gallery)
    groups = {}
    for entry in sorted(left.keys() | right.keys()):
        a, b = left[entry], right[entry]
        if a == b:
            continue
        kind = 'missing' if a < b else 'extra'
        signature = f'{scene}/{width}/gallery/' + entry_signature(kind, entry)
        groups.setdefault(signature, []).append(f'{entry}: live {a}, gallery {b}')
    return [dict(fail=signature, summary='; '.join(evidence))
            for signature, evidence in groups.items()]


def parse(data):
    def constant(value):
        raise ValueError('invalid JSON constant: ' + value)
    return json.loads(data, parse_constant=constant)


def scene_widths(record, scene):
    if type(record) is not dict or record.get('format') != 'look-capture/1':
        raise ValueError('expected look-capture/1')
    scenes = record['scenes']
    if type(scenes) is not list:
        raise ValueError('unreadable scenes')
    matches = [item for item in scenes if item['name'] == scene]
    if len(matches) != 1:
        raise ValueError('scene absent or repeated: ' + scene)
    widths = matches[0]['widths']
    if type(widths) is not list or not widths:
        raise ValueError('unreadable widths')
    result = {}
    for width in widths:
        name = width['name']
        if type(name) is not str or not NAME.fullmatch(name) or name in result:
            raise ValueError('unreadable or repeated width')
        result[name] = width
    return result


def read_outline(directory, width):
    file = width['page']['outline']
    if (type(file) is not dict or set(file) != {'path', 'bytes', 'sha256'}
            or type(file['path']) is not str or type(file['bytes']) is not int
            or file['bytes'] < 0 or type(file['sha256']) is not str):
        raise ValueError('unreadable outline record')
    relative = Path(file['path'])
    if relative.is_absolute() or '..' in relative.parts:
        raise ValueError('outline path outside capture')
    path = (directory / relative).resolve()
    if not path.is_relative_to(directory.resolve()):
        raise ValueError('outline path outside capture')
    data = path.read_bytes()
    if len(data) != file['bytes'] or 'sha256:' + hashlib.sha256(data).hexdigest() != file['sha256']:
        raise ValueError('outline size or digest differs')
    return data.decode('utf-8')


def judge(live_dir, gallery_dir, pairs):
    records = []
    errors = (OSError, ValueError, KeyError, TypeError, UnicodeError)
    for pair in pairs:
        try:
            live, separator, gallery = pair.partition('=')
            if not separator or not NAME.fullmatch(live) or not NAME.fullmatch(gallery):
                raise ValueError('expected LIVE=GALLERY')
            directory = live_dir / live
            a = scene_widths(parse((directory / 'capture.json').read_bytes()), live)
            b = scene_widths(parse((gallery_dir / 'capture.json').read_bytes()), gallery)
        except errors as error:
            records.append(dict(undecided=f'{pair}: {error}'))
            continue
        for width in sorted(a.keys() | b.keys()):
            try:
                if width not in a or width not in b:
                    raise ValueError('width absent from one capture')
                records.extend(compare(read_outline(directory, a[width]),
                                       read_outline(gallery_dir, b[width]), live, width))
            except errors as error:
                records.append(dict(undecided=f'{live}/{width}: {error}'))
    status = 1 if any('fail' in record for record in records) else 2 if records else 0
    return status, records


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--live', type=Path, required=True)
    parser.add_argument('--gallery', type=Path, required=True)
    parser.add_argument('pairs', nargs='+')
    args = parser.parse_args(argv)
    status, records = judge(args.live, args.gallery, args.pairs)
    for record in records:
        print(json.dumps(record, sort_keys=True, separators=(',', ':'), ensure_ascii=False))
    return status


if __name__ == '__main__':
    sys.exit(main())
