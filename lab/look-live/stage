#!/bin/sh
# Extract the subject's gallery printout, then apply the optional fault.
set -eu
if [ "$#" -ne 3 ]; then
    echo 'usage: stage TAR OUT EXPERIMENT' >&2
    exit 2
fi
archive=$1
out=$2
experiment=$3
mkdir -p "$out"
/bin/tar -x -f "$archive" -C "$out" --no-same-owner --no-same-permissions
set -- "$out"/bundle/*/temper.css
if [ "$#" -eq 1 ] && [ ! -f "$1" ]; then
    echo "stage: expected exactly one $out/bundle/*/temper.css; found: none (pattern: $1)" >&2
    exit 1
fi
if [ "$#" -ne 1 ]; then
    echo "stage: expected exactly one $out/bundle/*/temper.css; found: $*" >&2
    exit 1
fi
stylesheet=$1
if [ -f "$experiment/planted.css" ]; then
    cat "$experiment/planted.css" >> "$stylesheet"
fi
