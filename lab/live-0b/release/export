#!/bin/sh
# qa-live.md 4.3, 4: the account moved out to the held file's place, for the runner to give back.
# Arguments: TEMPER CLIENT_DIRECTORY FILE GROUND_DIRECTORY.
set -eu
temper=$1 client=$2 file=$3 ground=$4
umask 077
account=$(cat "$ground/account" 2>/dev/null) || account=
# No account moved in: the held file was never taken in, so it is left where it is.
[ -n "$account" ] || { echo "no account was imported" >&2; exit 1; }
"$temper" ctl "$client" export "$account" "$file"
