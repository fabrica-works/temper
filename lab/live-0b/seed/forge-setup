#!/bin/sh
# qa-live.md 3.1, 0a: the seed's `ctl forge-setup 1`, its answer kept for the ground check.
# Arguments: TEMPER CLIENT_DIRECTORY GROUND_DIRECTORY.
set -u
temper=$1 client=$2 ground=$3
umask 077
"$temper" ctl "$client" forge-setup 1 >"$ground/forge-setup.txt"
status=$?
cat "$ground/forge-setup.txt"
exit "$status"
