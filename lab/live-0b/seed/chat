#!/usr/bin/env -S python3 -I -B
"""One chat turn in the project forge-setup made, its reply kept for the chat check.

qa-live.md 3.1, 0b. Arguments: TEMPER CLIENT_DIRECTORY GROUND_DIRECTORY. Writes the
chat's task number to `task` and its conversation, once replied, to `chat.json`.
"""
import json
from pathlib import Path
import re
import subprocess
import sys
import time

TEXT = 'Reply with one short sentence saying you are ready. Do not delegate or change anything.'
SECONDS = 200


def main(argv):
    temper, client, ground = argv
    ground = Path(ground)
    deadline = time.monotonic() + SECONDS

    def ctl(*args):
        left = max(1, int(deadline - time.monotonic()))
        answer = subprocess.run([temper, 'ctl', client, *args], stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, timeout=left, check=False)
        sys.stdout.buffer.write(answer.stdout.rstrip(b'\n') + b'\n')
        if answer.returncode != 0:
            raise SystemExit(answer.returncode)
        return answer.stdout.decode('utf-8')

    me = json.loads(ctl('me', '--json'))
    projects = [p['project'] for p in me['projects'] if p['name']['bytes'] == 'hello']
    if len(projects) != 1:
        print('chat: no one project hello', file=sys.stderr)
        return 1
    created = ctl('chat', '--project', str(projects[0]), '--key', 'ground-chat', TEXT)
    match = re.fullmatch(r'done: task ([1-9][0-9]*), chat\n', created)
    if match is None:
        print('chat: expected done: task N, chat', file=sys.stderr)
        return 1
    task = match[1]
    (ground / 'task').write_text(task + '\n')
    left = max(1, int(deadline - time.monotonic()))
    ctl('wait', 'task', task, '--until', 'replied', '--timeout', str(left), '--json')
    (ground / 'chat.json').write_text(ctl('chat', task, '--json'))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
