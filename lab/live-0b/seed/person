#!/bin/sh
# The person's act at their first sign-in (protocol/setup.md, 6.5), by Forgejo's command line
# on the run's work path: ada's password needs no change, and a read token for the checks
# goes to GROUND/token, private, never printed.
# Arguments: FORGEJO FORGE_DIRECTORY GROUND_DIRECTORY.
set -eu
forgejo=$1 forge=$2 ground=$3
work=$forge/forgejo
umask 077
env -i HOME="$forge/home" PATH=/usr/bin:/bin "$forgejo" --work-path "$work" --config "$work/app.ini" \
    admin user must-change-password --unset ada
env -i HOME="$forge/home" PATH=/usr/bin:/bin "$forgejo" --work-path "$work" --config "$work/app.ini" \
    admin user generate-access-token --username ada --token-name lab-check --scopes read:repository --raw \
    >"$ground/token"
test -s "$ground/token"
echo "person ada: usable, a read token kept"
