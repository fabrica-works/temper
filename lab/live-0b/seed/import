#!/bin/sh
# qa-live.md 4.3, 2: the held record moved in, its account's number kept for the release.
# Arguments: TEMPER CLIENT_DIRECTORY FILE GROUND_DIRECTORY.
set -u
temper=$1 client=$2 file=$3 ground=$4
umask 077
"$temper" ctl "$client" import "$file" --key lab-import >"$ground/import.txt"
status=$?
cat "$ground/import.txt"
[ "$status" -eq 0 ] || exit "$status"
sed -n 's/^moved in: account \([1-9][0-9]*\).*/\1/p' "$ground/import.txt" >"$ground/account"
test -s "$ground/account"
