#!/usr/bin/env -S python3 -I -B
"""Judge 0b's chat turn from its retained conversation (qa-live.md 3.1; skein's lab.md 7.2).

Arguments: CHAT_JSON, `ctl chat N --json` once the chat replied. A reply is an assistant
text block with words in one of the chat's decoded turns; `wait --until replied` alone
is met by a run that failed. Exit 0 pass, 1 fail, 2 could not judge.
"""
import json
from pathlib import Path
import sys


def replies(chat):
    for row in chat['activity']['rows']:
        decoded = row['event'].get('owner', {}).get('decoded') or {}
        turn = (decoded.get('turn') or {}).get('decoded') or {}
        for message in turn.get('messages', []):
            if message.get('speaker') == 'assistant':
                for block in message.get('blocks', []):
                    text = (block.get('text') or {}).get('text', '')
                    if text.strip():
                        yield text


def ended(chat):
    for row in chat['activity']['rows']:
        line = row['event'].get('owner', {}).get('source', {}).get('line') or {}
        if 'run_ended' in line:
            yield line['run_ended']


def main(argv):
    if len(argv) != 1:
        print(json.dumps({"undecided": "usage: chat CHAT_JSON"}))
        return 2
    try:
        chat = json.loads(Path(argv[0]).read_bytes())
        found = list(replies(chat))
        endings = list(ended(chat))
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        print(json.dumps({"undecided": "chat unreadable"}))
        return 2
    if not found:
        print(json.dumps({"fail": "no-reply", "summary": "no assistant words in the chat: %s" % (endings[:1],)}))
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
