#!/usr/bin/env -S python3 -I -B
"""temper's spend so far, for skein's meter (qa-live.md 6.2; lab.md 6.5).

Until ctl reads a project's period, sums `spent` over the tasks `ctl tasks` lists at
the top of their trees (funded by the project's pool, a delegate's spend counted up the
chain that funded it), live and ended, in every project the party holds. The last stdout
line is the sum in the deployment's unit, a thousand tokens.
Arguments: TEMPER CLIENT_DIRECTORY.
"""
import json
import subprocess
import sys


def ctl(temper, client, *args):
    answer = subprocess.run([temper, 'ctl', client, *args, '--json'], stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, timeout=20, check=True)
    return json.loads(answer.stdout)


def budget(value):
    """The first `budget` holding `numbers` and a `funder`, depth first: a row's own."""
    if isinstance(value, dict):
        found = value.get('budget')
        if isinstance(found, dict) and 'numbers' in found and 'funder' in found:
            return found
        value = list(value.values())
    if isinstance(value, list):
        for item in value:
            found = budget(item)
            if found is not None:
                return found
    return None


def spent(answer):
    """The spend of the rows funded by a pool, from `tasks` and from `tasks --ended`."""
    if 'tasks' in answer:
        rows = answer['tasks']['rows']
    else:
        rows = answer['live'] + answer['ended']['rows']['rows']
    total = 0
    for row in rows:
        found = budget(row)
        if found is not None and 'pool' in found['funder']:
            total += found['numbers']['spent']
    return total


def main(argv):
    temper, client = argv
    total = 0
    for project in ctl(temper, client, 'me')['projects']:
        for ended in ((), ('--ended',)):
            rows = ctl(temper, client, 'tasks', '--project', str(project['project']), *ended)
            total += spent(rows)
    print(total)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
