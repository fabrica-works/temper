#!/usr/bin/env -S python3 -I -B
"""Judge 0a's ground from retained files alone (qa-live.md 3.1; skein's lab.md 7.2).

Arguments: TEMPER_COLLECTION FORGE_COLLECTION FORGE_SETUP_ANSWER. Exit 0 pass, 1 fail,
2 could not judge; stdout carries one JSON line per failure or undecided input.
"""

import json
from pathlib import Path
import sys

ADOPTED = ("Adopted work/hello on forge 1 as owned.", "It is the project's home.")


def load(path):
    try:
        return json.loads(Path(path).read_bytes())
    except (OSError, ValueError):
        return None


def named(me, name):
    projects = me.get("projects") if isinstance(me, dict) else None
    return any((project.get("name") or {}).get("bytes") == name for project in projects or [])


def judge(temper, forge, answer):
    """Failures as (signature, summary), and the inputs that could not be read."""
    inputs = {
        "forges": load(Path(temper) / "forges.json"),
        "me": load(Path(temper) / "me.json"),
        "tasks": load(Path(forge) / "tasks.json"),
        "status": load(Path(forge) / "status.json"),
        "repository": load(Path(forge) / "repository.json"),
    }
    try:
        lines = Path(answer).read_text(encoding="utf-8").splitlines()
    except (OSError, ValueError):
        lines = None
    missing = [name for name, value in inputs.items() if value is None] + (["forge-setup"] if lines is None else [])
    if missing:
        return [], missing
    failures = []
    rows = [row for row in inputs["forges"].get("forges", []) if row.get("number") == 1]
    if not rows or rows[0].get("mode") != "owned" or rows[0].get("state") != "connected":
        failures.append(("forge/not-connected", "forge 1 is not an owned forge connected: %s" % (rows[:1],)))
    made_row = (rows[0].get("first") or {}) if rows else {}
    made = (made_row.get("org"), made_row.get("repository"), made_row.get("project"), made_row.get("state"))
    if made != ("work", "hello", {"new": "hello"}, "made") or any(line not in lines for line in ADOPTED):
        failures.append(("adoption/missing", "work/hello is not made in hello and adopted as its home: %s" % (made_row,)))
    if not named(inputs["me"], "hello"):
        failures.append(("project/missing", "the party holds no project named hello"))
    repository = inputs["repository"]
    if repository.get("full_name") != "work/hello":
        failures.append(("repository/missing", "the forge has no work/hello"))
    elif repository.get("private") is not True or repository.get("default_branch") != "main":
        failures.append(("repository/shape", "work/hello is not private on main"))
    runs = inputs["tasks"].get("workflow_runs") or []
    first = min(runs, key=lambda run: run.get("run_number", 0)) if runs else None
    if first is None or (first.get("workflow_id"), first.get("event"), first.get("head_branch")) != ("ci.yml", "push", "main"):
        failures.append(("actions/first-run/missing", "no first run of ci.yml for a push to main"))
    elif first.get("status") != "success":
        failures.append(("actions/first-run/" + str(first.get("status")), "the starter workflow's first run is not green"))
    state = inputs["status"].get("state")
    if state != "success":
        failures.append(("status/" + str(state), "main's combined status is not success"))
    return failures, []


def main(argv):
    if len(argv) != 3:
        print(json.dumps({"undecided": "usage: ground TEMPER FORGE FORGE_SETUP"}))
        return 2
    failures, missing = judge(*argv)
    for signature, summary in failures:
        print(json.dumps({"fail": signature, "summary": summary}))
    if failures:
        return 1
    for name in missing:
        print(json.dumps({"undecided": name + " unreadable"}))
    return 2 if missing else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
