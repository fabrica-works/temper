#!/usr/bin/env -S python3 -I -B
"""Collect the owned Forgejo's account of work/hello through its API, live.

qa-live.md 3.1, 0a: the starter workflow's first run on Forgejo's Actions. Polls the
repository's runs until the first is completed or the deadline passes, then keeps the
answers. The person's read token is read from its file, which is then removed; it is never
printed or kept.
Arguments: TOKEN_FILE PORT OUT [--seconds S].
"""

import argparse
import http.client
import json
from pathlib import Path
import sys
import time

REPOSITORY = "work/hello"
PENDING = {"waiting", "running", "blocked", "queued", "pending", "unknown"}


def get(port, token, path):
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=10)
    # Direct numeric loopback listener: no proxy, redirects or retries.
    try:
        connection.request("GET", path, headers={"Authorization": "token " + token, "Accept": "application/json"})
        response = connection.getresponse()
        return response.status, response.read()
    finally:
        connection.close()


def first_run(body):
    runs = json.loads(body).get("workflow_runs") or []
    return min(runs, key=lambda run: run.get("run_number", 0)) if runs else None


def main(argv):
    parser = argparse.ArgumentParser()
    parser.add_argument("token", type=Path)
    parser.add_argument("port", type=int)
    parser.add_argument("out", type=Path)
    parser.add_argument("--seconds", type=int, default=200)
    args = parser.parse_args(argv)
    token = args.token.read_text(encoding="ascii").strip()
    args.token.unlink()  # The token lives from the seed to here alone, whatever the run's outcome.
    base = "/api/v1/repos/" + REPOSITORY
    deadline = time.monotonic() + args.seconds
    while True:
        status, body = get(args.port, token, base + "/actions/tasks")
        run = first_run(body) if status == 200 else None
        if run is not None and run.get("status") not in PENDING or time.monotonic() >= deadline:
            break
        time.sleep(1)
    (args.out / "tasks.json").write_bytes(body)
    for name, path in (("status", base + "/commits/main/status"), ("repository", base)):
        _, answer = get(args.port, token, path)
        (args.out / (name + ".json")).write_bytes(answer)
    print(json.dumps({"tasks": status, "first": run and run.get("status")}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
