family temper-client-wire 4

# The role, as temper-engine-domain-forge's Role, in its order.
enum Role { owned, adopted, fork, context }

# The keyed request (client/README.md, 4.6): forge::Adoption's fields in its order,
# the provider's repository id and the host left out. Byte fields take
# Bounds.field_bytes; checks Bounds.checks.
record Adopt { project: u32 home: bool forge: u16 owner: bytes 1024 name: bytes 1024 prefix: bytes 1024 role: Role landing: bytes 1024 ci: bool checks: list 64 u32 }

# The family's keyed requests and setup outcome (client/README.md, 4.6).
record SetUp { forge: u16 }
enum Request { adopt: Adopt, set_up: SetUp }
versioned record Requesting { request: Request }
enum SetUpRefusal { not_offered, not_under_the_box, busy }
record SetUpRefused { why: SetUpRefusal }

# The deployment's forges, in number order (client/README.md, 4.6).
enum Kind { forgejo, github }
enum Mode { connected, managed, owned, fake }
enum SetUpStep { fetch, prepare, run }
record SettingUp { step: option SetUpStep }
record SetUpFailed { why: bytes 256 }
record Connected { id: u64 login: bytes 1024 }
record Stopped { reason: bytes 1024 }
enum Connection { not_connected, not_set_up, setting_up: SettingUp, set_up_failed: SetUpFailed, connecting, connected: Connected, stopped: Stopped }
# Whether the deployment offers to set the forge up here (client/README.md, 4.6):
# the forge domain's, from its configuration, the box and its state.
enum Offer { not_offered, not_under_the_box, offered }
record ForgeRow { number: u16 kind: Kind mode: Mode connection: Connection offer: Offer }
versioned record Forges { forges: list 16 ForgeRow }

# The family's read name and its demo answer (client/README.md, 4.6).
# No demo is the read's empty answer, with no record.
enum Read { demo }
versioned record Reading { read: Read }
versioned record DemoAnswer { project: u32 forge: u16 provider: u32 owner: bytes 1024 name: bytes 1024 cues: list 8 text 256 }

# A change's watched panel (client/README.md, 4.6; client/forge.md, 9.2).
record ChangeSubject { task: u64 }
enum Watch { change: ChangeSubject, forges }
versioned record Watching { watch: Watch }
record Pull { number: u64 address: bytes 2048 }
record Queued { place: u32 ahead: list 64 u64 }
record GateReason { gate: u64 }
enum Reason { ci, gate: GateReason, semantic }
record Repairing { reason: Reason }
record Landed { merge: fixed 32 }
enum Step { producing, opening, recreating, reopening, checking, gating, queued: Queued, first, updating, resolving, repairing: Repairing, landing, landed: Landed }
enum Hold { stalled, repairs, resolutions, updates, moved, missing, closed, retargeted, failed, rejected }
enum Ci { unknown, pending, passed, failed }
enum GateKind { review, approval, check }
enum Verdict { none, pending, approved, changes }
record Gate { number: u64 kind: GateKind blocks: bool verdict: Verdict }
record Used { used: u32 limit: u32 }
versioned record ChangePanel { task: u64 forge: u16 owner: bytes 1024 name: bytes 1024 branch: bytes 1024 landing: bytes 1024 head: option fixed 32 pull: option Pull step: Step hold: option Hold runs: option u64 ci: Ci gates: list 64 Gate repairs: Used resolutions: Used updates: Used }

# Its outcome (client/README.md, 4.6 and 4.7).
record Kinds { read: bool push: bool open: bool land: bool review: bool status: bool comment: bool issue: bool branch: bool }
record Rule { branch: bytes 1024 contexts: list 64 bytes 1024 approvals: u32 dismiss_stale: bool }
enum Protection { unknown, absent, rule: Rule }
record Adopted { forge: u16 repository: u32 owner: bytes 1024 name: bytes 1024 role: Role home: bool kinds: Kinds protection: Protection }
# jig-client-protocol-wire's Refusal, encoded at jig's VERSION; 16777209 so
# that Answer at its ceiling fits jig's Owned.record (16777216).
record CoreRefused { refusal: bytes 16777209 }
enum ForgeReason { no_such_forge, not_found, no_access, refused, in_flight, too_large, unreachable, invalid_answer }
record ForgeRefused { reason: ForgeReason }
# unknown: the outcome's retention ended (02.2's Delivery::Application
# outcome None; client/README.md, 4.7, "unknown past the retention").
enum Outcome { adopted: Adopted, core_refused: CoreRefused, forge_refused: ForgeRefused, unknown, setting_up, set_up_refused: SetUpRefused }
versioned record Answer { outcome: Outcome }
