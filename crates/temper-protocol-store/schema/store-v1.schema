family temper-store 1

# 04.2: values the families share (store/README.md, 2 and 3).
record Repository { forge: u16 repository: u32 }
record Number { number: u64 }
record Commit { commit: fixed 32 }
# A branch's segments: one piece, each segment after its u32 length;
# limit 4 x forge.name_bytes.
record Segments { segments: bytes 65536 }
enum What { repository, branch: Segments, pull: Number, issue: Number }
record Name { forge: u16 repository: u32 what: What }
enum ItemState { open, closed }
enum Ci { none, pending, passed, failed }
# The contexts: one piece; limit client.answer_bytes + 4 x client.rows.
record Protection { branch: bytes 1048576 contexts: bytes 2097152 approvals: u32 dismiss_stale: bool }
record Settings { default_branch: bytes 1048576 merge: bool squash: bool rebase: bool }

# 04.2: family 2, Repository (forge::Repository).
enum Role { owned, adopted, fork, context }
record Kinds { read: bool push: bool open: bool land: bool review: bool status: bool comment: bool issue: bool branch: bool }
enum RepositoryProtection { unknown, absent, rule: Protection }
record Adopted { project: u32 home: bool provider: Repository host: bytes 4096 owner: bytes 4096 name: bytes 4096 prefix: bytes 4096 role: Role ci: bool checks: list 1024 u32 kinds: Kinds protection: RepositoryProtection settings: Settings }
# 04.2: family 3, Hold.
record RunWriter { task: u64 attempt: u64 }
enum Writer { run: RunWriter, lost: RunWriter, entry: Number }
record BranchDrift { expected: fixed 32 observed: option fixed 32 }
record Retargeted { number: u64 before: bytes 4096 after: bytes 4096 }
enum DriftChange { branch: BranchDrift, pull_closed: Number, retargeted: Retargeted }
record Drift { at: u64 change: DriftChange }
record Hold { name: Name task: u64 writer: option Writer drift: option Drift }
# 04.2: family 4, Names.
record Names { task: u64 resources: list 1024 Name }
# 04.2: family 5, Subscription (forge::Subscriber).
record LandingsTopic { repository: Repository branch: bytes 4096 }
record CiTopic { repository: Repository head: fixed 32 }
record NumberTopic { repository: Repository number: u64 }
enum Topic { landings: LandingsTopic, ci: CiTopic, pull: NumberTopic, participation: NumberTopic }
record Subscriber { task: u64 number: u64 topic: Topic own_change: option u64 goal_tasks: option list 65536 u64 paths: list 1024 bytes 4096 }
# 04.2: families 6 to 9.
record BranchHead { name: Name commit: fixed 32 owned: bool }
record PullState { name: Name head: fixed 32 ci: Ci state: ItemState }
record CiState { repository: Repository head: fixed 32 status: Ci }
record Landed { commit: fixed 32 task: u64 }
# 04.2: family 14, Release.
enum ReleaseEnding { done, failed, cancelled }
record PendingRelease { entry: u64 name: option Name }
record ReleaseRow { task: u64 root: u64 ending: ReleaseEnding close_pull: option u64 pending_release: option PendingRelease failed: bool effects_settled: bool releasing: bool }

# 04.3a: writes, conditions, proposed effects and outbox entries.
enum Verdict { approve, request_changes, comment }
enum Check { pending, passed, failed }
record CreateIssue { key: bytes 1048576 title: bytes 1048576 body: bytes 1048576 }
record OpenPull { title: bytes 1048576 body: bytes 1048576 head: bytes 1048576 base: bytes 1048576 }
record Post { number: u64 key: bytes 1048576 body: bytes 1048576 }
record PostReview { number: u64 key: bytes 1048576 verdict: Verdict body: bytes 1048576 }
record Edit { number: u64 title: option bytes 1048576 body: option bytes 1048576 }
record SetReviewers { number: u64 reviewers: list 65536 u64 }
record MergeWrite { number: u64 head: fixed 32 }
record SetStatus { commit: fixed 32 context: bytes 1048576 status: Check }
record CreateBranch { branch: bytes 1048576 commit: fixed 32 }
record DeleteBranch { branch: bytes 1048576 }
enum Write { create_issue: CreateIssue, open_pull: OpenPull, post: Post, review: PostReview, edit: Edit, set_reviewers: SetReviewers, close: Number, reopen: Number, merge: MergeWrite, update: Number, status: SetStatus, create_branch: CreateBranch, delete_branch: DeleteBranch }
record MergeCondition { base: bytes 1048576 }
record UpdateCondition { head: fixed 32 base: fixed 32 }
enum Condition { none, merge: MergeCondition, update: UpdateCondition, review: Commit }
record Effect { write: Write condition: Condition }
record Position { at: u64 comment: u64 review: u64 review_page: u32 }
record Attempt { sent: u64 deadline: u64 wall: u64 expires: u64 }
record Entry { number: u64 task: u64 repository: Repository effect: Effect start: option Position attempt: option Attempt failures: u32 }
record EntryRow { entry: Entry held: bool }
record ProposedEffect { number: u64 resource: What entry: Entry }

# 04.3b: named effects, errors and reads without answer-item pieces.
record RateLimited { after: duration }
enum Error { unavailable, timeout, rate_limited: RateLimited, forbidden, missing, missing_job, too_large, empty, full, exists, nothing_to_merge, closed, stale, conflict, protected, refused, invalid_answer, busy }
record ErrorValue { error: Error }
enum Made { created: Number, commented: Number, reviewed: Number, merged: Commit, updated: Commit, branch: Commit, set }
record OutcomeMade { made: Made found: bool }
record OutcomeRaced { made: Made why: Error }
enum Outcome { made: OutcomeMade, failed: ErrorValue, raced: OutcomeRaced, uncertain, held, withdrawn }
enum Permission { none, read, write, admin }
enum BranchCreation { created, exists }
record Pull { reviewers: list 65536 u64 number: u64 state: ItemState head: bytes 1048576 base: bytes 1048576 commit: fixed 32 base_commit: option fixed 32 merged: option fixed 32 mergeable: bool ci: Ci }
record JobAttempt { head: fixed 32 run: u64 job: u64 attempt: u32 }
record JobAnswer { attempt: JobAttempt log: bytes 1048576 truncated: bool }
record FileAnswer { head: fixed 32 path: bytes 1048576 bytes: bytes 1048576 truncated: bool }
record BranchesAnswer { branches: bytes 2097152 }
record ProtectionAnswer { protection: option Protection }
record PermissionValue { permission: Permission }
record BranchCreationValue { creation: BranchCreation }
enum Answer { pull: Pull, commit: Commit, branches: BranchesAnswer, job: JobAnswer, file: FileAnswer, protection: ProtectionAnswer, settings: Settings, permission: PermissionValue, created: Number, commented: Number, reviewed: Number, merged: Commit, branch: BranchCreationValue, done }
record AnswerValue { answer: Answer }
enum ReadResult { answer: boxed AnswerValue, error: ErrorValue }
record CallRead { result: ReadResult }
record CallEffect { entry: u64 deadline: u64 outcome: option Outcome }
enum CallPayload { effect: CallEffect, refused: ErrorValue, read: CallRead }
record NamedCall { task: u64 attempt: u64 completion: u32 position: u32 }
record Call { key: NamedCall answer: CallPayload }
enum Value { call: Call, proposed_effect: ProposedEffect, repository: Adopted, hold: Hold, names: Names, subscription: Subscriber, branch_head: BranchHead, pull_state: PullState, ci: CiState, landed: Landed, entry: EntryRow, release: ReleaseRow }
versioned record Row { value: Value }
